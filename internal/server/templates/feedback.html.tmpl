<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex">
<title>Radar</title>
<style>
:root{--bg:#f4f2ee;--fg:#1f1f1f;--muted:#6f6a60;--card:#fff;--line:#ddd8ce}
@media (prefers-color-scheme:dark){:root{--bg:#1b1a18;--fg:#ece9e3;--muted:#a39d92;--card:#252320;--line:#3a3733}}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--fg);font:16px/1.5 -apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif}
main{max-width:560px;margin:12vh auto;padding:0 16px}
.card{background:var(--card);border:1px solid var(--line);border-radius:14px;padding:24px}
.brand{font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.kicker{margin-top:14px;font-size:14px;font-weight:600;color:var(--muted)}
h1{margin:4px 0 0;font-size:20px;line-height:1.35;font-weight:650}
h1 a{color:inherit;text-decoration:none}
h1 a:hover{text-decoration:underline}
p{margin:8px 0 0;color:var(--muted);font-size:15px}
.row{display:flex;flex-wrap:wrap;gap:8px;margin-top:20px}
form{margin:0}
button{font:inherit;font-size:14px;padding:8px 14px;border-radius:8px;border:1px solid var(--line);background:transparent;color:var(--fg);cursor:pointer}
button.primary{background:var(--fg);border-color:var(--fg);color:var(--bg)}
</style>
</head>
<body>
<main>
<div class="card">
  <div class="brand">Radar</div>
{{- if .Error}}
  <h1 style="margin-top:14px">{{.Error}}</h1>
{{- else}}
  <div class="kicker">{{.Kicker}}</div>
  <h1><a href="{{.Item.URL}}">{{.Item.Title}}</a></h1>
  {{- if .Message}}<p>{{.Message}}</p>{{end}}
  <div class="row">
  {{- range .Actions}}
    <form method="post" action="{{.Path}}"{{if .Primary}} id="auto"{{end}}><button{{if .Primary}} class="primary"{{end}}>{{.Label}}</button></form>
  {{- end}}
  </div>
  {{- if not .Done}}
  <script nonce="{{.Nonce}}">document.getElementById("auto").submit()</script>
  {{- end}}
{{- end}}
</div>
</main>
</body>
</html>
