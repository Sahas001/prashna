<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="color-scheme" content="light">
<title>{{.Subject}}</title>
</head>
<body style="margin:0;padding:0;background:#f4f2ee;">
<div style="max-width:640px;margin:0 auto;padding:28px 16px 40px;font-family:-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,Helvetica,Arial,sans-serif;color:#1f1f1f;">
  <div style="font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:#8a8478;">Radar</div>
  <h1 style="margin:4px 0 8px;font-size:24px;line-height:1.25;font-weight:650;">{{.Date.Format "Monday, 2 January"}}</h1>
  <div style="font-size:14px;color:#6f6a60;">{{.Count}} picks, ranked against your interests.</div>
{{range .Sections}}
  <h2 style="margin:36px 0 16px;padding-bottom:6px;border-bottom:1px solid #ddd8ce;font-size:12px;letter-spacing:.1em;text-transform:uppercase;font-weight:600;color:#8a8478;">{{.Title}}</h2>
{{- range .Entries}}
  <table role="presentation" cellpadding="0" cellspacing="0" border="0" style="width:100%;border-collapse:collapse;margin:0 0 26px;"><tr>
  {{- if .Cover}}
  <td style="width:76px;vertical-align:top;padding:2px 16px 0 0;"><a href="{{.Item.URL}}"><img src="{{.Cover}}" width="76" alt="" style="display:block;width:76px;height:auto;border:0;border-radius:3px;box-shadow:0 1px 3px rgba(0,0,0,.18);"></a></td>
  {{- end}}
  <td style="vertical-align:top;">
    <a href="{{.Item.URL}}" style="font-size:17px;font-weight:600;line-height:1.35;color:#1f1f1f;text-decoration:none;">{{.Item.Title}}</a>
    {{- if or .Byline .Discussion}}
    <div style="margin-top:4px;font-size:13px;line-height:1.4;color:#6f6a60;">{{.Byline}}{{if .Discussion}}{{if .Byline}} · {{end}}<a href="{{.Discussion}}" style="color:#6f6a60;">discussion</a>{{end}}</div>
    {{- end}}
    {{- if .Snippet}}
    <div style="margin-top:6px;font-size:14px;line-height:1.55;color:#3a3a3a;">{{.Snippet}}</div>
    {{- end}}
    <div style="margin-top:8px;font-size:13px;line-height:1.6;">
      <a href="{{.Up}}" style="color:#2f6f4f;text-decoration:none;white-space:nowrap;">👍 More like this</a>&nbsp;&nbsp;&nbsp;
      <a href="{{.Down}}" style="color:#9a3b3b;text-decoration:none;white-space:nowrap;">👎 Less</a>
      {{- if .Why}}&nbsp;&nbsp;&nbsp;<span style="color:#a39d92;">{{.Why}}</span>{{end}}
    </div>
  </td></tr></table>
{{- end}}
{{- end}}
  <div style="margin-top:40px;padding-top:12px;border-top:1px solid #ddd8ce;font-size:12px;line-height:1.5;color:#a39d92;">
    Your ratings tune future digests. Each item is only sent once.
  </div>
</div>
</body>
</html>
